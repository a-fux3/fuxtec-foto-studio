{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuxtec-foto-studio",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    // "kie" = Claude über Kie (nutzt KIE_API_KEY) · "anthropic" = eigener Anthropic-Key (ANTHROPIC_API_KEY)
    "CLAUDE_PROVIDER": "kie",
    // Analyse + Qualitätskontrolle
    "CLAUDE_MODEL": "claude-opus-5-5",
    // Retusche-Modell (in der App umschaltbar): gpt-image-2-5-flare-image-to-image | nano-banana-2 | nano-banana-pro
    "KIE_EDIT_MODEL": "gpt-image-2-5-flare-image-to-image",
    // KI-Schatten (in der App umschaltbar): nano-banana-2 | nano-banana-2-1 | nano-banana-pro | gpt-image-2-5-flare-image-to-image
    "KIE_SHADOW_MODEL": "gpt-image-2-5-flare-image-to-image",
    "KIE_REMOVE_BG_MODEL": "recraft/remove-background",
    // Preis pro Kie-Credit in Euro: 1.000 Credits = 5 $ ≈ 4,46 € (Kurs Okt. 2026: 1 $ ≈ 0,89 €)
    "CREDIT_EUR": "0.0045"
  },
  "observability": { "enabled": true }
}
